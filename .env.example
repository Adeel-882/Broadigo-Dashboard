# PostgreSQL connection used by Slack ingestion and production analytics.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/broadigo
DATABASE_POOL_MAX=5

# Slack secrets remain server-side only.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_ID=

# Session signing key. Must be at least 32 characters in production.
# Administrator sign-in credentials are fixed server-side in lib/auth/password.ts.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Development-only convenience. Never enable in production.
DEMO_AUTH_BYPASS=false

# Optional local visual-review data. Ignored in production even if set.
DEMO_DATA_ENABLED=false
